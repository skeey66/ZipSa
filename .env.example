# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.  cp .env.example .env
# .env 는 절대 커밋하지 않습니다.

# ── DB ─────────────────────────────────
POSTGRES_DB=zipsa
POSTGRES_USER=zipsa
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# docker compose 로 띄울 때 호스트에 노출할 DB 포트(로컬 5432 와 충돌 방지)
DB_HOST_PORT=5433
# docker compose 로 띄울 때 프론트 포트
FRONTEND_PORT=3000

# ── JWT ────────────────────────────────
# 최소 32자 이상. 아래 명령으로 생성:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# ── OpenAI (정책·뉴스 AI 요약 / 내 상황 적용 판단) ──
# https://platform.openai.com/api-keys 에서 발급 (sk- 로 시작)
# ⚠️ 서버 전용 키입니다. VITE_ 접두사를 붙이면 브라우저 번들에 박혀서 그대로 노출됩니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 카카오 (지도 · 주소→좌표) ───────────
# https://developers.kakao.com > 내 애플리케이션 (앱 1개에서 키 2종이 나옵니다)
#
# ① JavaScript 키 — 프론트에서 지도 렌더링 (화면 10, 11)
#    플랫폼 > Web 에 http://localhost:5173, http://localhost:3000 둘 다 등록해야 동작합니다.
#    브라우저에 노출되는 값이라 도메인 등록으로 보호합니다.
VITE_KAKAO_MAP_KEY=
#
# ② REST API 키 — 크롤러에서 주소 → 좌표 변환 (지오코딩)
#    국토부 실거래가 API 는 좌표를 주지 않습니다. 지도에 마커를 찍으려면
#    법정동+지번 주소를 좌표로 바꿔야 real_estate_transactions.latitude/longitude 가 채워집니다.
KAKAO_REST_API_KEY=

# ── 공공데이터포털 (data.go.kr) ──────────
# 회원가입 > 마이페이지 > 인증키 발급현황 에서 확인.
# ★ 인증키는 "계정당 1개"입니다. API 마다 따로 나오지 않습니다.
#   활용신청한 API 들이 전부 이 키 하나에 묶이고, 달라지는 건 엔드포인트뿐입니다.
#
# ⚠️ "인코딩"과 "디코딩" 두 가지가 보입니다.
#    Python requests 의 params= 로 넘길 때는 반드시 "디코딩" 키를 쓰세요.
#    인코딩 키를 넣으면 requests 가 한 번 더 인코딩해서(%25..) 아래 에러가 납니다:
#      <errMsg>SERVICE_KEY_IS_NOT_REGISTERED_ERROR</errMsg>
#    "등록되지 않은 서비스키" 라고 나와서 키를 잘못 받은 줄 알고 헤매기 쉽습니다.
#
# 검증된 엔드포인트 (2026-09 확인, 셋 다 serviceKey 파라미터 사용):
#
#  ① 아파트 매매 실거래가 상세          → 화면 11 (deal_type = SALE)
#     https://apis.data.go.kr/1613000/RTMSDataSvcAptTradeDev/getRTMSDataSvcAptTradeDev
#  ② 아파트 전월세 실거래가             → 화면 11 (deal_type = JEONSE / MONTHLY)
#     https://apis.data.go.kr/1613000/RTMSDataSvcAptRent/getRTMSDataSvcAptRent
#       ①② 공통 파라미터: LAWD_CD=법정동코드 앞 5자리, DEAL_YMD=YYYYMM,
#                         numOfRows, pageNo   (한 번에 "1개 지역 × 1개월" 만 조회됨)
#  ③ LH 임대주택 공고문                  → 화면 09, 10
#     활용신청 후 상세페이지의 엔드포인트를 확인해서 여기에 적을 것
DATA_GO_KR_SERVICE_KEY=

# ── 온통청년 청년정책 API ────────────────
# 화면 01 메인 · 06 정책리스트 · 07 정책상세 의 데이터 원천
#
# 신청 경로 2가지 — ①을 권장 (자동승인이라 바로 받음)
#  ① 공공데이터포털: data.go.kr/data/15143273/openapi.do
#     "한국고용정보원_온통청년_청년정책API" 활용신청 → 개발단계 자동승인, 무료
#  ② 온통청년 직접: youthcenter.go.kr 로그인 > 마이페이지 > OPEN API > 인증키 신청
#     담당자 심사 후 승인이라 시간이 걸립니다.
#
# 검증된 엔드포인트(2026-09 기준):
#   GET https://www.youthcenter.go.kr/go/ythip/getPlcy
#       ?apiKeyNm=<키>&pageNum=1&pageSize=100&rtnType=json
#   · 인증키 파라미터명은 serviceKey 가 아니라 apiKeyNm 입니다.
#   · rtnType=json 지원 (공식 가이드에는 XML 이라고만 적혀 있으나 JSON 됩니다).
#   · 키가 틀리면: {"errorCode":"e001","errorMsg":"invalid api key."}
#   · 구 엔드포인트 /opi/youthPlcyList.do 는 302 로 죽었습니다. 쓰지 마세요.
YOUTH_CENTER_API_KEY=

# ── 크롤러 ──────────────────────────────
CRAWL_USER_AGENT="ZipSaBot/1.0 (+https://github.com/skeey66/ZipSa)"
CRAWL_DELAY_SECONDS=1.0
